# Copy to .env to override docker-compose defaults.

# TimescaleDB
POSTGRES_USER=tsdbadmin
POSTGRES_PASSWORD=tsdbpass
POSTGRES_DB=metrics
POSTGRES_PORT=5432

# Ingest service
INGEST_PORT=8080

# Grafana
GRAFANA_PORT=3000
GF_USER=admin
GF_PASSWORD=admin

# MinIO (S3-compatible cold storage)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=timescale-cold

# Tiering (hot = TimescaleDB, cold = Parquet on MinIO)
# TIER_ENABLED=true runs the background tierer; the POST /api/v1/tier/run
# endpoint works regardless. TIER_HOT_WINDOW is how recent data must be to
# stay in TimescaleDB.
TIER_ENABLED=false
TIER_HOT_WINDOW=7 days
